---
const base = import.meta.env.BASE_URL;
const githubUrl = "https://github.com/ydah/cceye";
const npmUrl = "https://www.npmjs.com/package/cceye";

const features = [
  {
    number: "01",
    title: "Track locally",
    copy: "Read Claude Code JSONL logs where they already live. No account, sync service, or cloud data required.",
  },
  {
    number: "02",
    title: "Explain every cost",
    copy: "Separate estimated, reported, and unpriced usage with pricing provenance you can inspect.",
  },
  {
    number: "03",
    title: "Act before limits",
    copy: "Set daily, weekly, and monthly thresholds with console, Slack, email, and macOS notifications.",
  },
];

const steps = [
  { number: "01", label: "Discover", copy: "Find Claude Code project logs" },
  { number: "02", label: "Normalize", copy: "Parse usage into a durable ledger" },
  { number: "03", label: "Understand", copy: "Report costs and quality signals" },
  { number: "04", label: "Notify", copy: "Deliver threshold alerts reliably" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="cceye is a local-first usage and cost monitor for Claude Code."
    />
    <meta name="theme-color" content="#071925" />
    <link rel="icon" type="image/svg+xml" href={base + "/favicon.svg"} />
    <title>cceye — Claude Code cost visibility</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav container" aria-label="Main navigation">
        <a class="brand" href={base} aria-label="cceye home">
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M4.4 16s4.2-7 11.6-7 11.6 7 11.6 7-4.2 7-11.6 7S4.4 16 4.4 16Z" />
            <circle cx="16" cy="16" r="3.25" />
          </svg>
          <span>cceye</span>
        </a>
        <div class="nav-links">
          <a href={base + "#features"}>Features</a>
          <a href={base + "#how-it-works"}>How it works</a>
          <a href={githubUrl} target="_blank" rel="noreferrer">GitHub <span class="external-arrow" aria-hidden="true">↗</span></a>
        </div>
        <a class="nav-cta" href={base + "#get-started"}>Get started <span aria-hidden="true">→</span></a>
      </nav>
    </header>

    <main>
      <section class="hero container">
        <div class="hero-copy">
          <div class="eyebrow"><span class="status-dot" aria-hidden="true"></span> LOCAL-FIRST COST VISIBILITY</div>
          <h1>Make every<br /><em>token count.</em></h1>
          <p class="hero-lede">
            cceye turns Claude Code usage logs into clear costs, reliable alerts, and decisions you can trust — without sending your data anywhere.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href={githubUrl} target="_blank" rel="noreferrer">
              View on GitHub <span aria-hidden="true">↗</span>
            </a>
            <a class="button button-quiet" href={base + "#get-started"}>See how it works <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-note"><span class="lock-icon" aria-hidden="true">⌁</span> Local by default <span class="note-divider">·</span> MIT licensed <span class="note-divider">·</span> Node.js 20+</div>
        </div>

        <div class="hero-visual">
          <div class="visual-glow" aria-hidden="true"></div>
          <div class="dashboard-window" role="img" aria-label="Illustration of a cceye cost dashboard">
            <div class="window-chrome">
              <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
              <span class="window-title">cceye / status</span>
              <span class="window-live"><span class="live-dot"></span> LIVE</span>
            </div>
            <div class="dashboard-body">
              <div class="dashboard-topline">
                <div>
                  <span class="dashboard-label">THIS MONTH</span>
                  <strong class="dashboard-total">$18.42</strong>
                </div>
                <div class="trend-pill"><span aria-hidden="true">↗</span> 12.8%</div>
              </div>
              <div class="dashboard-chart" aria-hidden="true">
                <div class="chart-grid"><span></span><span></span><span></span><span></span></div>
                <div class="chart-bars"><i class="bar bar-1"></i><i class="bar bar-2"></i><i class="bar bar-3"></i><i class="bar bar-4"></i><i class="bar bar-5"></i><i class="bar bar-6"></i><i class="bar bar-7"></i><i class="bar bar-8"></i><i class="bar bar-9"></i><i class="bar bar-10"></i><i class="bar bar-11"></i><i class="bar bar-12"></i></div>
              </div>
              <div class="dashboard-stats">
                <div class="mini-stat"><span>Input tokens</span><strong>2.4M</strong></div>
                <div class="mini-stat"><span>Output tokens</span><strong>684K</strong></div>
                <div class="mini-stat"><span>Coverage</span><strong class="coverage-value">98.7%</strong></div>
              </div>
              <div class="dashboard-footer"><span><span class="tiny-dot"></span> All systems clear</span><span>Updated just now</span></div>
            </div>
          </div>
          <div class="floating-tag tag-top"><span class="tag-icon">$</span> PRICING PROVENANCE</div>
          <div class="floating-tag tag-bottom"><span class="tag-check" aria-hidden="true">✓</span> THRESHOLD SAFE</div>
        </div>
      </section>

      <section class="signal-strip" aria-label="Product properties">
        <div class="container signal-items">
          <div><span class="signal-index">01</span><strong>Private by design</strong><span>Logs stay on your machine.</span></div>
          <div><span class="signal-index">02</span><strong>Built for clarity</strong><span>No mystery totals.</span></div>
          <div><span class="signal-index">03</span><strong>Ready for action</strong><span>Alerts when it matters.</span></div>
        </div>
      </section>

      <section class="section container" id="features">
        <div class="section-heading">
          <div>
            <span class="section-kicker">WHY CCEYE</span>
            <h2>The useful layer<br /><span>between logs and limits.</span></h2>
          </div>
          <p>Usage data is only useful when it is accurate, explainable, and connected to the next decision. cceye keeps that path short.</p>
        </div>
        <div class="feature-grid">
          {features.map((feature) => (
            <article class="feature-card">
              <div class="feature-number">{feature.number}</div>
              <div class="feature-rule" aria-hidden="true"></div>
              <h3>{feature.title}</h3>
              <p>{feature.copy}</p>
              <span class="feature-arrow" aria-hidden="true">↗</span>
            </article>
          ))}
        </div>
      </section>

      <section class="process-section" id="how-it-works">
        <div class="container process-layout">
          <div class="process-intro">
            <span class="section-kicker">HOW IT WORKS</span>
            <h2>From raw usage<br /><span>to clear action.</span></h2>
            <p>A small, local pipeline that makes cost visibility a part of your normal development workflow.</p>
            <a class="text-link" href={githubUrl} target="_blank" rel="noreferrer">Read the source <span aria-hidden="true">↗</span></a>
          </div>
          <div class="steps-list">
            {steps.map((step, index) => (
              <div class="step-row">
                <span class="step-number">{step.number}</span>
                <div class="step-copy"><strong>{step.label}</strong><span>{step.copy}</span></div>
                <span class:list={["step-status", index === steps.length - 1 && "step-status-final"]} aria-hidden="true">{index === steps.length - 1 ? "→" : "·"}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="section install-section container" id="get-started">
        <div class="install-card">
          <div class="install-copy">
            <span class="section-kicker">GET STARTED</span>
            <h2>See your usage<br /><span>in a clearer light.</span></h2>
            <p>Install cceye in one command. Start with a local status check, then add the workflow that fits your team.</p>
            <div class="install-links">
              <a class="button button-primary" href={npmUrl} target="_blank" rel="noreferrer">Install from npm <span aria-hidden="true">↗</span></a>
              <a class="button button-quiet" href={githubUrl} target="_blank" rel="noreferrer">Explore the repo <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="code-card" aria-label="Installation command">
            <div class="code-card-top"><span class="code-dot"></span> Terminal <span class="code-path">~/projects</span></div>
            <pre><code><span class="prompt">$</span> npm install -g cceye
<span class="prompt">$</span> cceye status

<span class="code-muted">✓ Usage collected</span>
<span class="code-muted">✓ Pricing resolved</span>
<span class="code-success">✓ No threshold breaches</span></code></pre>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <a class="brand" href={base} aria-label="cceye home">
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M4.4 16s4.2-7 11.6-7 11.6 7 11.6 7-4.2 7-11.6 7S4.4 16 4.4 16Z" />
            <circle cx="16" cy="16" r="3.25" />
          </svg>
          <span>cceye</span>
        </a>
        <span class="footer-note">A local-first usage FinOps tool for Claude Code.</span>
        <div class="footer-links"><a href={githubUrl} target="_blank" rel="noreferrer">GitHub ↗</a><a href={npmUrl} target="_blank" rel="noreferrer">npm ↗</a><span>MIT License</span></div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
